<?xml version="1.0"?>
<model>
  <name>arm_base</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Joel Devasia</name>
    <email>helpdesk@e-yantra.org</email>
  </author>

  <description>
    Base the UR7e stands on. Model origin is at floor level; the mesh is
    0.655 x 0.640 m across and 0.5857 m tall, with its main flat top face at
    0.4807 and a raised rim to 0.5857. Collision is the bounding box, not the
    mesh, which carries 1.7 M triangles and is far too heavy to collide against.
  </description>
</model>
