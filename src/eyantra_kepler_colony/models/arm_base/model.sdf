<?xml version="1.0"?>
<sdf version="1.6">
  <model name="arm_base">
    <static>true</static>
    <link name="arm_base_link">

      <visual name="visual">
        <pose>0 0 0.2864 0 0 0</pose>
        <geometry>
          <mesh><uri>model://arm_base/meshes/arm_base.glb</uri></mesh>
        </geometry>
      </visual>

      <collision name="collision">
