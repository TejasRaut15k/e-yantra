        <geometry>
          <box><size>0.655 0.640 0.5857</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>

    </link>
  </model>
</sdf>
